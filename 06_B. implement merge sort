#include <iostream>
using namespace std;

void merge(int a[], int s, int mid, int e) {
    int temp[100];
    int i = s, j = mid + 1, k = 0;

    while (i <= mid && j <= e) {
        if (a[i] < a[j])
            temp[k++] = a[i++];
        else
            temp[k++] = a[j++];
    }

    while (i <= mid)
        temp[k++] = a[i++];

    while (j <= e)
        temp[k++] = a[j++];

    for (i = s, k = 0; i <= e; i++, k++)
        a[i] = temp[k];
}

void mergeSort(int a[], int s, int e) {
    if (s < e) {
        int mid = (s + e) / 2;

        mergeSort(a, s, mid);
        mergeSort(a, mid + 1, e);
        merge(a, s, mid, e);
    }
}

int main() {
    int n, a[100];

    cout << "Enter number of elements: ";
    cin >> n;

    cout << "Enter elements: ";
    for (int i = 0; i < n; i++)
        cin >> a[i];

    mergeSort(a, 0, n - 1);

    cout << "Sorted array: ";
    for (int i = 0; i < n; i++)
        cout << a[i] << " ";

    return 0;
}
